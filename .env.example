# Copie este arquivo para ".env" na raiz do projeto e preencha os valores
# antes de rodar "docker compose up".

# MySQL — DB_PASSWORD também é usada como senha do usuário root do container mysql
DB_NAME=finapp
DB_PASSWORD=

# Backend
JWT_SECRET=
JWT_EXPIRES_IN=7d

# IA (opcional) — deixe AI_PROVIDER em branco para desativar
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=
OLLAMA_URL=
OLLAMA_MODEL=
